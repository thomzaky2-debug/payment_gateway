# =====================================================================
# InstaPay Payment Gateway Environment Configuration
# =====================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Hosted deployments must use a different origin for the owner portal, for
# example https://admin.example.com. The API rejects browser /api/admin calls
# from every other origin.
ADMIN_URL=http://localhost:5173
# Public API hostname baked into the Vite build. Leave blank locally so Vite's
# /api and /socket.io proxy remains active. Example: https://api.example.com
VITE_API_BASE_URL=
# Public canonical admin portal URL used by the frontend to route /admin away
# from the merchant site. Example: https://admin.example.com
VITE_ADMIN_URL=

# Supabase PostgreSQL Database Connection
# Copy the exact strings from Supabase Dashboard → Connect. A persistent API
# should use the Session pooler (port 5432) or direct connection for queries.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres?sslmode=require"
# Use the direct connection for Prisma migrations; if the host is IPv4-only,
# use the Supavisor Session pooler string instead.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Security & Cryptography Secrets
# Generate with: openssl rand -hex 32
OWNER_SECRET="replace-with-a-very-long-random-secret-for-owner-sessions"
TOKEN_PEPPER="replace-with-a-random-pepper-for-hashing-api-and-detector-tokens"

# Platform Owner Bootstrap (Initial Superadmin)
ADMIN_EMAIL="admin@paymentgateway.local"
ADMIN_PASSWORD="ChangeMeInProduction123!"
# Base32 secret with at least 160 bits (32 Base32 characters), provisioned into an authenticator app
# and required outside development/test.
ADMIN_TOTP_SECRET=""

# Local development only. The server refuses these in production-like runtimes.
AUTH_ALLOW_DEV_BYPASS=false
AUTH_EXPOSE_DEV_OTP=false
AUTH_ACCEPT_LEGACY_SESSIONS=false

# Enable only after replacing apks/ with current, release-signed builds.
ENABLE_APK_DOWNLOADS=false

# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY=0

# Upstash Redis: required outside local development for shared rate limiting.
# Copy both values from the database's Connect tab in the Upstash console.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# Platform InstaPay Accounts (For Merchant Subscription Billing)
PLATFORM_INSTAPAY_HANDLE="platform@instapay"
PLATFORM_INSTAPAY_PAYMENT_URL="https://ipn.eg/S/platform/instapay/TOKEN"

# Checkout & Real-time Settings
CHECKOUT_TTL_MIN=10
SOCKET_IO_PORT=3001

# Webhook Retries & Security (Fail-closed by default: strictly HTTPS, public destinations only)
WEBHOOK_MAX_RETRIES=5
ALLOW_HTTP_WEBHOOKS=false
ALLOW_PRIVATE_WEBHOOKS=false

# OTP email delivery. Gmail requires 2-Step Verification and a Google App
# Password; never place the normal Google account password in SMTP_PASS.
RESEND_API_KEY=""
EMAIL_FROM="InstaPay Payment Gateway <instapay.payment.gateway@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="instapay.payment.gateway@gmail.com"
SMTP_PASS=""
