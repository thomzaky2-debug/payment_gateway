# =====================================================================
# InstaPay Payment Gateway Environment Configuration
# =====================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL Database Connection
# Pooled connection string (Transaction pooler for queries):
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection string (Session pooler for migrations):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Security & Cryptography Secrets
# Generate with: openssl rand -hex 32
OWNER_SECRET="replace-with-a-very-long-random-secret-for-owner-sessions"
TOKEN_PEPPER="replace-with-a-random-pepper-for-hashing-api-and-detector-tokens"

# Platform Owner Bootstrap (Initial Superadmin)
ADMIN_EMAIL="admin@paymentgateway.local"
ADMIN_PASSWORD="ChangeMeInProduction123!"
# Base32 secret with at least 160 bits (32 Base32 characters), provisioned into an authenticator app
# and required outside development/test.
ADMIN_TOTP_SECRET=""

# Local development only. The server refuses these in production-like runtimes.
AUTH_ALLOW_DEV_BYPASS=false
AUTH_EXPOSE_DEV_OTP=false
AUTH_ACCEPT_LEGACY_SESSIONS=false

# Enable only after replacing apks/ with current, release-signed builds.
ENABLE_APK_DOWNLOADS=false

# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY=0

# Platform InstaPay Accounts (For Merchant Subscription Billing)
PLATFORM_INSTAPAY_HANDLE="platform@instapay"
PLATFORM_INSTAPAY_PAYMENT_URL="https://ipn.eg/S/platform/instapay/TOKEN"

# Checkout & Real-time Settings
CHECKOUT_TTL_MIN=10
SOCKET_IO_PORT=3001

# Webhook Retries & Security
WEBHOOK_MAX_RETRIES=5
ALLOW_HTTP_WEBHOOKS=true
ALLOW_PRIVATE_WEBHOOKS=true

# Optional SMTP / Resend Email Provider for OTP Verification
RESEND_API_KEY=""
EMAIL_FROM="noreply@paymentgateway.local"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
