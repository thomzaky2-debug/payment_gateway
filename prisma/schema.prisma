// Multi-tenant Paymob-Style Payment Gateway — Prisma Schema (PostgreSQL for Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Platform owner (admin) ────────────────────────────────────────
model Owner {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  dstMode      String   @default("AUTO")
  createdAt    DateTime @default(now())
}

model PublicSiteSettings {
  id        String   @id @default("public")
  content   Json
  updatedAt DateTime @updatedAt
}

// ─── Merchant email verification OTPs ─────────────────────────────
model EmailVerification {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  purpose    String    @default("MERCHANT_SIGNUP")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

// ─── Client / Merchant Account (Self-Service) ──────────────────────
model Client {
  id                 String  @id @default(cuid())
  slug               String  @unique
  businessName       String
  businessType       String?
  instapayHandle     String
  instapayPaymentUrl String?

  // Self-registration contact & credentials
  firstName      String?
  lastName       String?
  whatsappNumber String?
  profileImageData String?
  email          String  @unique
  passwordHash   String

  // Authentication keys (Generated ONLY after Admin Approval)
  apiKey                String?   @unique
  detectToken           String?   @unique
  apiKeyHash            String?   @unique
  detectTokenHash       String?   @unique
  apiKeyLastUsedAt      DateTime?
  detectTokenLastUsedAt DateTime?

  // Status: PENDING | APPROVED | REJECTED
  approvalStatus String  @default("PENDING")
  isActive       Boolean @default(false)

  // Webhook integration
  webhookUrl        String?
  webhookSecret     String?
  webhookSecretHash String?

  // Settings
  checkoutTtlMin Int @default(10)

  // Payment Precision & Review Policies
  autoAcceptOverpaid        Boolean @default(true)
  overpaidMaxExcessEgp      Float?  @default(100.0)
  underpaidToleranceEnabled Boolean @default(false)
  underpaidToleranceEgp     Float   @default(5.0)

  // Subscription & Free Trial
  subscriptionPlan   String    @default("FREE_TRIAL")
  subscriptionEndsAt DateTime?
  isFreeTrial        Boolean   @default(true)
  trialRedeemedAt    DateTime?
  txLimit            Int       @default(5)
  txCount            Int       @default(0)

  // Account deletion tracking
  deletionRequestedAt DateTime?
  deletedAt           DateTime?

  // Set by admin suspension; a deletion-grace login must not clear it.
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]
  webhookLogs        WebhookLog[]
  mismatchedPayments MismatchedPayment[]
  detectorDevices    DetectorDevice[]
  notifications      MerchantNotification[]
  bundlePurchases    BundlePurchase[]
  authSessions       AuthSession[]
  incomingPayments   IncomingPaymentEvent[]
  specialOffers      SpecialOffer[]
  subscriptionPlans     CustomerSubscriptionPlan[]
  customerSubscriptions CustomerSubscription[]
  customerInvoices      CustomerInvoice[]

  @@index([instapayHandle])
  @@index([instapayPaymentUrl])
  @@index([apiKey])
  @@index([detectToken])
  @@index([apiKeyHash])
  @@index([detectTokenHash])
  @@index([deletedAt])
}

// Merchant-specific commercial proposals for enterprise accounts.
model SpecialOffer {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  priceEgp        Float
  maxTransactions Int
  periodDays      Int
  status          String    @default("ACTIVE") // ACTIVE | ACCEPTED | REVOKED
  validUntil      DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId, status, validUntil])
  @@index([status, validUntil])
}

// Immutable ingestion ledger used to reject replayed detector notifications.
model IncomingPaymentEvent {
  id           String    @id @default(cuid())
  eventKey     String    @unique
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reference    String?
  senderHandle String
  amountCents  Int
  occurredAt   DateTime?
  sessionId    String?
  result       String    @default("PROCESSING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId, createdAt])
  @@index([clientId, reference])
  @@index([sessionId])
}

// ─── Revocable browser/native control-plane sessions ───────────────────────
// API keys and detector tokens remain separate integration credentials.
model AuthSession {
  id                    String    @id @default(cuid())
  tokenHash             String    @unique
  kind                  String // MERCHANT | OWNER
  clientId              String?
  client                Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userAgent             String?
  ipAddress             String?
  credentialFingerprint String?
  createdAt             DateTime  @default(now())
  lastSeenAt            DateTime  @default(now())
  expiresAt             DateTime
  revokedAt             DateTime?
  // Recent re-authentication (password or TOTP) unlocks sensitive actions until this time.
  stepUpExpiresAt       DateTime?

  // Mobile refresh token rotation
  refreshTokenHash      String?   @unique
  refreshExpiresAt      DateTime?
  familyId              String?
  rotatedAt             DateTime?
  deviceId              String?

  @@index([clientId, kind, revokedAt, expiresAt])
  @@index([kind, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([familyId])
  @@index([deviceId])
}

// ─── Top-Up Bundles (Extra Transaction Packs) ───────────────────────
model TopUpBundle {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. "STARTER_PACK", "GROWTH_PACK", "MEGA_PACK"
  displayName String // e.g. "Starter Pack", "Growth Pack"
  priceEgp    Float
  extraTx     Int // Number of extra transactions granted
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  purchases BundlePurchase[]
}

// ─── Bundle Purchase Records ────────────────────────────────────────
model BundlePurchase {
  id        String      @id @default(cuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bundleId  String
  bundle    TopUpBundle @relation(fields: [bundleId], references: [id])
  sessionId String? // Links to the Transaction used for payment
  extraTx   Int // Snapshot of how many tx were granted
  priceEgp  Float // Snapshot of the price paid
  status    String      @default("PENDING") // PENDING | CONFIRMED | EXPIRED
  createdAt DateTime    @default(now())

  @@index([clientId, createdAt])
  @@index([sessionId])
  @@index([status])
}

model MerchantNotification {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  message   String
  severity  String    @default("INFO")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([clientId, readAt])
}

// ─── Checkout / payment transaction ────────────────────────────────
model Transaction {
  id        String @id @default(cuid())
  sessionId String @unique @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  senderHandle    String
  recipientHandle String

  amountEgp   Float
  amountCents Int?
  currency    String @default("EGP")

  status               String  @default("PENDING")
  purpose              String  @default("CHECKOUT") // CHECKOUT | SUBSCRIPTION
  subscriptionPlanName String?
  note                 String?
  productCategory      String?
  items                Json?

  idempotencyKeyHash String?
  idempotencyRequestHash String?

  deepLinkUrl   String
  deepLinkToken String
  // Validated at creation; the hosted checkout only navigates to this value.
  returnUrl     String?

  detectedRef         String?
  detectedAt          DateTime?
  detectedAmountEgp   Float?
  detectedAmountCents Int?

  createdAt DateTime @default(now())
  expiresAt DateTime

  customerInvoice CustomerInvoice?

  @@unique([clientId, idempotencyKeyHash])
  @@index([clientId, status, createdAt])
  @@index([clientId, purpose, status])
  @@index([clientId, senderHandle, amountEgp, status])
  @@index([clientId, senderHandle, amountCents, status])
  @@index([status, expiresAt])
  @@index([deepLinkToken])
  @@index([createdAt])
}

// ─── Webhook Delivery Log ──────────────────────────────────────────
model WebhookLog {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url           String
  event         String
  eventId       String?
  payload       String // Stringified JSON payload
  statusCode    Int? // HTTP status code returned
  response      String? // Response body from merchant server
  isSuccess     Boolean
  attempt       Int       @default(1)
  nextAttemptAt DateTime?
  deliveryLockedUntil DateTime? // Short-lived claim that prevents concurrent worker/manual sends
  deliveryStartedAt DateTime? // Durable marker written before a network delivery begins
  outcomeKnown Boolean   @default(true) // False means delivery may have happened; requires manual review
  createdAt     DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([eventId])
  @@index([isSuccess, nextAttemptAt])
  @@index([deliveryLockedUntil])
  @@index([outcomeKnown, nextAttemptAt])
}

// ─── Administrative Audit Log ──────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g. "APPROVE_MERCHANT", "DISABLE_MERCHANT", "UPDATE_TZ", "FORCE_CONFIRM"
  details   String // Text description
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Unmatched / Mismatched Payment Logs ────────────────────────────
model MismatchedPayment {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  senderHandle String
  amountEgp    Float
  amountCents  Int?
  reference    String?
  status       String   @default("UNMATCHED") // UNMATCHED | RESOLVED
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
}

// ─── Android Detector Device Health ────────────────────────────────
model DetectorDevice {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceId       String
  name           String?
  credentialHash String?   @unique
  revokedAt      DateTime?
  appVersion     String?
  androidVersion String?
  lastSeenAt     DateTime  @default(now())
  lastIp         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([clientId, deviceId])
  @@index([clientId, lastSeenAt])
  @@index([clientId, revokedAt])
}

// ─── Subscription & Pricing Plans ───────────────────────────────────
model Plan {
  id              String    @id @default(cuid())
  name            String    @unique // FREE_TRIAL, BASIC, PRO, ENTERPRISE
  priceEgp        Float
  maxTransactions Int
  periodDays      Int       @default(30) // Admin controlled duration (e.g. 14 days for trial)
  description     String?
  isActive        Boolean   @default(true)
  offerPriceEgp   Float?
  offerLabel      String?
  offerEndsAt     DateTime?
}

// ─── Merchant Customer Subscription Plans ───────────────────────────
model CustomerSubscriptionPlan {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  amountEgp       Float
  amountCents     Int
  currency        String   @default("EGP")
  billingInterval String   @default("MONTHLY") // MONTHLY | WEEKLY | DAILY | YEARLY | CUSTOM_DAYS
  intervalDays    Int      @default(30)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions CustomerSubscription[]

  @@index([clientId, isActive])
  @@index([clientId, createdAt])
}

// ─── Customer Recurring Subscriptions / Schedules ───────────────────
model CustomerSubscription {
  id                 String                    @id @default(cuid())
  clientId           String
  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId             String?
  plan               CustomerSubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String
  customerPhone      String?
  senderHandle       String?
  amountEgp          Float
  amountCents        Int
  currency           String                    @default("EGP")
  billingInterval    String                    @default("MONTHLY") // MONTHLY | WEEKLY | DAILY | YEARLY | CUSTOM_DAYS
  intervalDays       Int                       @default(30)
  status             String                    @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | PAST_DUE
  currentPeriodStart DateTime                  @default(now())
  currentPeriodEnd   DateTime
  nextBillingAt      DateTime
  reminderDaysBefore Int                       @default(2)
  lastInvoiceAt      DateTime?
  canceledAt         DateTime?
  description        String?
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  invoices CustomerInvoice[]

  @@index([clientId, status, nextBillingAt])
  @@index([status, nextBillingAt])
  @@index([customerEmail])
}

// ─── Customer Invoices (Recurring Billing Cycles) ───────────────────
model CustomerInvoice {
  id                 String                @id @default(cuid())
  invoiceNumber      String                @unique
  clientId           String
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId     String?
  subscription       CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  transactionId      String?               @unique
  transaction        Transaction?          @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String
  customerPhone      String?
  senderHandle       String?
  amountEgp          Float
  amountCents        Int
  currency           String                @default("EGP")
  status             String                @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  sessionId          String?               @unique
  checkoutUrl        String?
  paidAt             DateTime?
  reminderSentAt     DateTime?
  overdueNotifiedAt  DateTime?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([clientId, status, createdAt])
  @@index([subscriptionId, status])
  @@index([status, dueDate])
  @@index([sessionId])
}
