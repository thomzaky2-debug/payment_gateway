# =====================================================================
# Local Deployment Environment Configuration (Template)
# =====================================================================

# Server & Client Ports
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Local Embedded PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres:password@localhost:54329/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:54329/postgres"

# Security & Cryptography Secrets
OWNER_SECRET="local-deploy-owner-secret-long-random-key-123456"
TOKEN_PEPPER="local-deploy-token-pepper-long-random-key-654321"

# Platform Superadmin Credentials
ADMIN_EMAIL="admin@paymentgateway.local"
ADMIN_PASSWORD="AdminPassword123!"

# Platform InstaPay Accounts (For Merchant Subscription Billing)
PLATFORM_INSTAPAY_HANDLE="platform@instapay"
PLATFORM_INSTAPAY_PAYMENT_URL="https://ipn.eg/S/platform/instapay/TOKEN"

# Checkout & Real-time Settings
CHECKOUT_TTL_MIN=15
SOCKET_IO_PORT=3001

# Webhook Retries & Security
WEBHOOK_MAX_RETRIES=3
ALLOW_HTTP_WEBHOOKS=true
ALLOW_PRIVATE_WEBHOOKS=true
