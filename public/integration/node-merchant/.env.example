# Offline demonstration: no bank transfer and no live NilePay session.
NILEPAY_API_URL=http://127.0.0.1:8090
NILEPAY_API_KEY=demo_key_local_only
NILEPAY_WEBHOOK_SECRET=demo_secret_local_only_change_for_live
APP_URL=http://localhost:8080
PORT=8080
MOCK_PORT=8090
